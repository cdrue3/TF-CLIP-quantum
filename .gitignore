# Data — too large for git
DATA/

# Checkpoints — never commit
*.pth.tar
*.pth

# Logs — allow .txt/.log results but not checkpoints
logs/**/*.pth.tar
logs/**/*.pth
# Allow logs/ text files (results, sweeps, train logs)

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Office / media files
*.pptx
*.pdf
*.png
*.jpg
*.jpeg

# Environment
.env
*.env

# IDE
.vscode/
.idea/

# Misc
*.npy
dist_mat.npy
*.pt
.claude/
